# ===== builder =====
FROM node:24-alpine AS builder

WORKDIR /app

COPY package*.json ./
COPY shared/package*.json ./shared/
COPY frontend/package*.json ./frontend/

RUN npm ci --workspace=frontend --workspace=shared

COPY shared/ ./shared/
COPY frontend/ ./frontend/

RUN npm run build --workspace=frontend

# ===== runtime =====
FROM nginx:stable-alpine

RUN apk add --no-cache openssl

RUN mkdir -p /etc/ssl/certs /etc/ssl/private
RUN openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
    -keyout /etc/ssl/private/nginx-selfsigned.key \
    -out /etc/ssl/certs/nginx-selfsigned.crt \
    -subj "/C=JP/ST=Tokyo/L=Tokyo/O=42Tokyo/OU=ft_transcendence/CN=ft_transcendence"

COPY --from=builder /app/frontend/dist /usr/share/nginx/html
COPY docker/nginx/conf/nginx.prod.conf /etc/nginx/conf.d/default.conf

# non-root で動作させる: イメージ組み込みの nginx ユーザーに切り替え、
# worker が書き込む一時ディレクトリと pid ファイル、証明書の所有権を調整する。
# master 自体が非特権ユーザーで起動するため、privileged port (<1024) には
# bind できず、listen は 8443 に変更している (nginx.prod.conf 側と Compose の
# port mapping も合わせて更新)。
RUN sed -i '/^user  *nginx;/d' /etc/nginx/nginx.conf \
    && sed -i 's#pid\s*/run/nginx.pid;#pid /tmp/nginx.pid;#' /etc/nginx/nginx.conf \
    && chown -R nginx:nginx /var/cache/nginx /etc/ssl/private /etc/ssl/certs \
    && chmod 400 /etc/ssl/private/nginx-selfsigned.key

USER nginx

EXPOSE 8443
