# ===== backend =====

# JWT configuration
# JWT secret key. Required, and must be at least 24 characters.
# The backend refuses to start while this is empty, so generate one with:
#   openssl rand -base64 24
JWT_SECRET=
# JWT token expiration time (e.g., 1d for 1 day, 2h for 2 hours)
JWT_EXPIRES_IN=1d

# PostgreSQL connection URL used by Prisma
# Format:
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://transcendence:transcendence@postgres:5432/transcendence?schema=public"

# postgres configuration
POSTGRES_USER=transcendence
POSTGRES_PASSWORD=transcendence
POSTGRES_DB=transcendence

# Comma-separated origins allowed to connect to Socket.IO namespaces
SOCKET_IO_CORS_ORIGIN=http://localhost:5173,https://localhost:8443

# ===== frontend =====

# Set to true only if hot reload does not react to file changes.
# Polling keeps the CPU busy continuously, so leave it false unless you need it
# (typically when the repository lives on a Windows/macOS filesystem mounted into Docker).
VITE_USE_POLLING=false
